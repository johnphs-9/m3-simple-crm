          </mxCell>
<mxCell id="c34" value="API contract (from controllers + test suite)" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica Neue;fontSize=16;fontColor=#1A1B1C;fontStyle=1;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="72" y="862" width="697" height="26" as="geometry" />
          </mxCell>
<mxCell id="c35" value="Public: POST /auth/login → 200 {token} | 401 empty body.  GET /health → 200 {status: UP}.&#10;Authenticated (any role): GET /api/hello (Bearer required), GET /customers, GET /customers/{id},&#10;GET /customers/search?firstName= and /search/job?jobTitle= (exact match) → 200 | 404.&#10;ADMIN only: POST /customers → 201, PUT /customers/{id} → 200, DELETE /customers/{id} → 204,&#10;POST /customers/{id}/interactions → 201.  Other roles → 403.  Invalid body → 400.&#10;Unknown id → 404 {message, timestamp}.  Customer payload: id, firstName, lastName, email,&#10;contactNo, jobTitle, yearOfBirth.  Interaction payload: id, remarks, interactionDate, customer." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica Neue;fontSize=14;fontColor=#1A1B1C;fontStyle=0;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="72" y="891" width="697" height="250" as="geometry" />
          </mxCell>
<mxCell id="c36" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F0F0C0;strokeColor=#1A1B1C;strokeWidth=1.5;dashed=0;fontColor=#1A1B1C;fontFamily=Helvetica Neue;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
            <mxGeometry x="825" y="845" width="727" height="205" as="geometry" />
          </mxCell>
<mxCell id="c37" value="Runtime configuration and scope" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica Neue;fontSize=16;fontColor=#1A1B1C;fontStyle=1;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="849" y="862" width="679" height="26" as="geometry" />
          </mxCell>
<mxCell id="c38" value="Dev profile: port 8080 · jdbc:postgresql://localhost:5432/simple_crm · ddl-auto=create.&#10;spring.config.import=optional:file:.env — JWT secret and app.auth.* login credentials.&#10;Token lifetime 3,600,000 ms (1 h). Basic users are separate from login credentials.&#10;Tests use H2 in-memory (crm-tests, create-drop). Prod profile is a port-only stub (8081).&#10;Student / Course entities and CourseRepository exist but are unused by the service layer.&#10;No frontend, no external identity provider, no deployment automation." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica Neue;fontSize=14;fontColor=#1A1B1C;fontStyle=0;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="849" y="891" width="679" height="155" as="geometry" />
          </mxCell>
<mxCell id="c39" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F4D7D7;strokeColor=#1A1B1C;strokeWidth=1.5;dashed=0;fontColor=#1A1B1C;fontFamily=Helvetica Neue;fontSize=16;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
            <mxGeometry x="825" y="1070" width="727" height="95" as="geometry" />
          </mxCell>
<mxCell id="c40" value="Development startup resets data" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica Neue;fontSize=16;fontColor=#1A1B1C;fontStyle=1;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="849" y="1087" width="679" height="26" as="geometry" />
          </mxCell>
<mxCell id="c41" value="Hibernate ddl-auto=create recreates tables. DataLoader then deletes customers and inserts four&#10;examples. No cascade delete exists for customer → interaction." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica Neue;fontSize=14;fontColor=#1A1B1C;fontStyle=0;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="849" y="1116" width="679" height="45" as="geometry" />
          </mxCell>
