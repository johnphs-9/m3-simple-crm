<mxCell id="c44" value="Role mapping and statelessness" style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica Neue;fontSize=14;fontColor=#1A1B1C;fontStyle=1;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="72" y="1237" width="1756" height="22" as="geometry" />
          </mxCell>
<mxCell id="c45" value="Authorities are re-read from the in-memory store on every request: a token subject that is not stored falls back to ROLE_USER, so the diagram-01 JWT (user) can GET /customers but gets 403 on writes. The store also serves HTTP Basic (user · admin).&#10;Sessions are stateless and CSRF is off — the client resends the Bearer header on every request." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica Neue;fontSize=14;fontColor=#1A1B1C;fontStyle=0;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="72" y="1265" width="1756" height="94" as="geometry" />
          </mxCell>
