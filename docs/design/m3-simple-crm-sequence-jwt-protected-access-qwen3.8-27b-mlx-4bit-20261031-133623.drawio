            </mxGeometry>
          </mxCell>
<mxCell id="c47" value="Solid arrows are calls; dashed arrows are returns. The 401 is produced by Spring Security authorization, not by the filter, which always continues the chain." style="text;html=0;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica Neue;fontSize=14;fontColor=#1A1B1C;fontStyle=0;spacing=0;" vertex="1" parent="1">
